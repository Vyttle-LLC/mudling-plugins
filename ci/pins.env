# The versions CI builds and downloads. One line each, because the workflows
# read this file as KEY=value.
#
# The MUDling commit that CI builds `mudling plugin test` from. It must be a
# full commit on Vyttle-LLC/mudling that has those tools. Change it when the
# plugin API or the tools change, and check the reference plugin afterwards:
# docs/ci.md#the-budget.
MUDLING_COMMIT=7efee42cfcaaae4778ffa05d6e0ac3e9df4647f3
# luau-analyze, from the release's luau-ubuntu.zip on luau-lang/luau.
LUAU_VERSION=0.745
LUAU_UBUNTU_SHA256=186e5ddaa2b048ebc7390c11ed1b00c04e7d3beaffed429250329e3575d2ece2
